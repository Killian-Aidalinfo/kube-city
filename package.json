{
  "name": "kube-city",
  "version": "1.1.2",
  "description": "Kube City : un jeu de ville multijoueur dans le navigateur, fait pour apprendre la haute disponibilité sur Kubernetes.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:client": "vite build --config client/vite.config.js",
    "dev:client": "vite --config client/vite.config.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8"
  }
}
